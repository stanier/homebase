[Unit]
Description=Roundcube webmail
After=network-online.target dovecot.service
Wants=network-online.target dovecot.service

[Container]
Image=docker.io/roundcube/roundcubemail:1.7.4-apache
# Network=host, not PublishPort -- reaches Dovecot's plaintext
# loopback-only IMAP listener (127.0.0.1:143 -- see dovecot's own
# 10-master.conf for why this is plaintext, not its externally-exposed
# 993) and the host's native Postfix submission port (127.0.0.1:587,
# see roles/mail_server) over loopback, same reasoning as
# dovecot.container. Neither hop leaves the host, and Postfix's
# submission listener only requires TLS opportunistically
# (smtpd_tls_security_level=may), so plaintext here isn't a downgrade
# from anything actually available -- Roundcube's container has no
# reason to trust our internal CA either way (see 10-master.conf).
# Caddy (container-sandbox) reverse_proxies webmail.{{ base_domain }} to
# this host's app_ip:80 -- see its own Caddyfile entry. Plain port 80,
# not a custom one -- this image (the regular apache variant, not
# -nonroot) always listens on 80 regardless of environment; there's no
# APACHE_PORT knob to change it (confirmed: no such variable is
# documented anywhere for this image -- an earlier version of this file
# set one anyway and it was silently ignored).
Network=host
Environment=ROUNDCUBEMAIL_DB_TYPE=sqlite
Environment=ROUNDCUBEMAIL_DEFAULT_HOST=127.0.0.1
Environment=ROUNDCUBEMAIL_DEFAULT_PORT=143
Environment=ROUNDCUBEMAIL_SMTP_SERVER=127.0.0.1
Environment=ROUNDCUBEMAIL_SMTP_PORT=587
EnvironmentFile=/srv/containers/container-files/roundcube/.env
Volume=roundcube_roundcube_db:/var/roundcube/db
Volume=roundcube_roundcube_config:/var/www/html/config

[Service]
Restart=always

[Install]
WantedBy=default.target
