#!/bin/bash
# Managed by ansible-playbooks (roles/appdeploy).
#
# Forced command for the appdeploy CI key: the client's command line
# arrives only as SSH_ORIGINAL_COMMAND arguments. Job containers have no
# podman socket, so the caller pipes its build context in as a tarball
# on stdin and the image is built here.
set -euo pipefail

export XDG_RUNTIME_DIR="/run/user/$(id -u)"

STATE_DIR="{{ containers_home }}/appdeploy/state"
PORTS_FILE="$STATE_DIR/ports.tsv"
BUILD_DIR="{{ containers_home }}/appdeploy/build"
QUADLET_DIR="{{ containers_home }}/.config/containers/systemd"
# Secrets never come through CI: an <app>.env here (placed by hand or by
# appdeploy_app_env) is handed to the container as EnvironmentFile=.
ENV_DIR="{{ containers_home }}/appdeploy/env"
DOMAIN_SUFFIX="{{ appdeploy_domain_suffix }}"
BASE_PORT="{{ appdeploy_base_port }}"
CADDY_ROUTE_KEY="{{ containers_home }}/.ssh/caddy_route_ed25519"
CADDY_ROUTE_HOST="{{ hostvars[appdeploy_caddy_route_hostname].ansible_host }}"
# Caddy's proxy target. Passed explicitly because the SSH hop to Caddy
# arrives from the management network, not the app network.
APP_HOST_APP_IP="{{ app_ip }}"

# shellcheck disable=SC2206 # word-splitting the client's command is the point
args=(${SSH_ORIGINAL_COMMAND:-})
app="${args[0]:-}"
tag="${args[1]:-}"
container_port="${args[2]:-}"
app_type="${args[3]:-http}"

if [[ -z "$app" || -z "$tag" || -z "$container_port" ]]; then
  echo "usage: <app> <tag> <container-port> [http|ssh]  (build context tar.gz piped on stdin)" >&2
  exit 1
fi

# $app ends up in file paths and hostnames; keep it strictly DNS-label.
if [[ ! "$app" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
  echo "invalid app name: $app" >&2
  exit 1
fi
if [[ ! "$tag" =~ ^[a-zA-Z0-9._-]+$ ]]; then
  echo "invalid tag: $tag" >&2
  exit 1
fi
if [[ ! "$container_port" =~ ^[0-9]+$ ]]; then
  echo "invalid container port: $container_port" >&2
  exit 1
fi
if [[ "$app_type" != "http" && "$app_type" != "ssh" ]]; then
  echo "invalid app type: $app_type (want http or ssh)" >&2
  exit 1
fi

build_dir="$BUILD_DIR/$app"
rm -rf "$build_dir"
mkdir -p "$build_dir"
tar xzf - -C "$build_dir"

# Fully qualified so Image= never goes through short-name resolution.
image="localhost/$app:$tag"
podman build -t "$image" "$build_dir"
rm -rf "$build_dir"

# Each app keeps the host port it was first assigned.
port=$(awk -F'\t' -v a="$app" '$1==a{print $2; found=1} END{exit !found}' "$PORTS_FILE" 2>/dev/null) || port=""
if [[ -z "$port" ]]; then
  last=$(cut -f2 "$PORTS_FILE" 2>/dev/null | sort -n | tail -1)
  port=$(( ${last:-$((BASE_PORT - 1))} + 1 ))
  printf '%s\t%s\n' "$app" "$port" >> "$PORTS_FILE"
fi

env_file_line=""
if [[ -f "$ENV_DIR/$app.env" ]]; then
  env_file_line="EnvironmentFile=%h/appdeploy/env/$app.env"
fi

cat > "$QUADLET_DIR/$app.container" <<EOF
[Unit]
Description=$app (appdeploy)

[Container]
Image=$image
PublishPort=$port:$container_port
Label=appdeploy=$app
$env_file_line

[Service]
Restart=always

[Install]
WantedBy=default.target
EOF

systemctl --user daemon-reload
if ! systemctl --user restart "$app.service"; then
  echo "--- $app.service failed to start; recent journal: ---" >&2
  journalctl --user -u "$app.service" --no-pager -n 40 >&2
  exit 1
fi

# This key can only run caddy-route.sh on the Caddy host.
ssh -i "$CADDY_ROUTE_KEY" -o BatchMode=yes "containers@$CADDY_ROUTE_HOST" "$app" "$port" "$app_type" "$APP_HOST_APP_IP"

if [[ "$app_type" == "ssh" ]]; then
  echo "deployed $app:$tag -> ssh $app.ssh.$DOMAIN_SUFFIX ({{ ansible_facts['default_ipv4'].address }}:$port)"
else
  echo "deployed $app:$tag -> https://$app.$DOMAIN_SUFFIX ({{ ansible_facts['default_ipv4'].address }}:$port)"
fi
