# Managed by ansible-playbooks (roles/postfix). Satellite system: accepts
# mail only from this host itself (inet_interfaces = loopback-only) and
# relays everything onward through the central delivery host's Postfix
# rather than attempting any direct delivery of its own.
myhostname = {{ ansible_fqdn | default(inventory_hostname) }}.{{ postfix_mydomain }}
mydomain = {{ postfix_mydomain }}

# myorigin deliberately left at Postfix's own default ($myhostname, not
# $mydomain) -- root's/cron's unqualified "root" gets qualified against
# myorigin before mydestination is checked, and mydestination below only
# lists $myhostname (not the bare $mydomain). Overriding myorigin to
# $mydomain would qualify "root" as root@{{ postfix_mydomain }} instead,
# which never matches mydestination, so alias(5) (/etc/aliases) never
# gets consulted at all -- the raw, unaliased "root" address would just
# get relayed as-is to the delivery host, which has no such mailbox.

relayhost = [{{ postfix_relay_host }}]:{{ postfix_relay_port }}

inet_interfaces = loopback-only
inet_protocols = ipv4
mydestination = $myhostname, localhost.$mydomain, localhost
mynetworks = 127.0.0.0/8

# A dedicated file in texthash's own format, not /etc/aliases itself --
# see templates/root_alias.j2's own comment for why. texthash reads it
# straight off disk with no indexing step, so newaliases is never
# needed; always set (even with no root alias configured, in which case
# the file is just empty) so Postfix always has a valid table to open
# at startup instead of warning about a missing one.
alias_maps = texthash:/etc/postfix/root_alias

compatibility_level = 3
