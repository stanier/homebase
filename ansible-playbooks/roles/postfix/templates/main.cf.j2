# Managed by ansible-playbooks (roles/postfix). Satellite: accepts mail
# only from this host and relays everything to the delivery host.
myhostname = {{ ansible_facts['fqdn'] | default(inventory_hostname) }}.{{ postfix_mydomain }}
mydomain = {{ postfix_mydomain }}

# myorigin stays $myhostname: with $mydomain, "root" would be qualified
# to an address that misses mydestination, skip the alias, and get
# relayed as-is to a mailbox that doesn't exist.

relayhost = [{{ postfix_relay_host }}]:{{ postfix_relay_port }}

inet_interfaces = loopback-only
inet_protocols = ipv4
mydestination = $myhostname, localhost.$mydomain, localhost
mynetworks = 127.0.0.0/8

# texthash, not /etc/aliases -- see root_alias.j2.
alias_maps = texthash:/etc/postfix/root_alias

compatibility_level = 3
