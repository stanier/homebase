# Managed by ansible-playbooks (roles/mail_server). Receiving MTA for
# {{ mail_server_domain }}: accepts relayed mail from the roles/postfix
# satellites and delivers to the Dovecot container over LMTP.
myhostname = {{ ansible_facts['fqdn'] | default(inventory_hostname) }}.{{ mail_server_domain }}
mydomain = {{ mail_server_domain }}
myorigin = $mydomain
mydestination =

inet_interfaces = all
inet_protocols = ipv4
mynetworks = {{ mail_server_relay_networks | join(' ') }}

virtual_mailbox_domains = {{ mail_server_domain }}
virtual_mailbox_maps = texthash:/etc/postfix/virtual_mailboxes
virtual_transport = lmtp:127.0.0.1:24

# Empty: nothing is local delivery, and the hash: default warns on every
# start since this build has no Berkeley DB.
alias_maps =

# Copies, not /srv/dovecot/tls -- see the copy task in tasks/main.yml.
smtpd_tls_cert_file = /etc/postfix/tls/tls.crt
smtpd_tls_key_file = /etc/postfix/tls/tls.key
smtpd_tls_security_level = may
smtp_tls_security_level = may

compatibility_level = 3
