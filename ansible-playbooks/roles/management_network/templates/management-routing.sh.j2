#!/bin/sh
# Managed by ansible-playbooks (roles/management_network). Idempotent --
# run on every boot by management-network-routing.service, safe to
# re-run by hand too. See tasks/main.yml for why this exists: traffic
# from management_ip needs to reply out {{ management_interface }} via
# {{ management_gateway }}, not out the main default route.

ip rule add from {{ management_ip }} table {{ management_route_table_name }} 2>&1 | grep -v "File exists" || true
ip route replace default via {{ management_gateway }} dev {{ management_interface }} table {{ management_route_table_name }}

# Copy the interface's on-link subnet route into the table too. Without
# it, traffic from management_ip to a neighbour on the same VLAN (the
# other node, a VM's mgmt NIC) also matches the default above and
# hairpins through the gateway instead of going direct -- the firewall
# then only sees one direction of each TCP flow and drops it.
ip -4 route show table main dev {{ management_interface }} scope link | while read -r net _; do
    ip route replace "$net" dev {{ management_interface }} scope link src {{ management_ip }} table {{ management_route_table_name }}
done
