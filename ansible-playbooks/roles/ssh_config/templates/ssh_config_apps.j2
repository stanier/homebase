# Managed by ansible-playbooks (roles/ssh_config). SSH wrapped in TLS so
# app-proxy's Caddy layer4 can route it by SNI.
{% for app in appdeploy_ssh_apps %}

Host {{ app }}.ssh.{{ ssh_config_env }}
    ProxyCommand openssl s_client -quiet -connect {{ hostvars['app-proxy'].app_ip }}:443 -servername {{ app }}.ssh.apps.{{ base_domain }} 2>/dev/null
{% endfor %}
