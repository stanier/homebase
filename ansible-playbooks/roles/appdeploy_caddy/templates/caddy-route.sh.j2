#!/bin/bash
# Managed by ansible-playbooks (roles/appdeploy_caddy).
#
# Forced command for app-host's caddy-route key: writes one route file
# and reloads Caddy. app_host is app-host's app_ip, passed explicitly
# because this SSH hop arrives over the management network.
set -euo pipefail

CADDY_APPS_DIR="{{ containers_home }}/appdeploy-state/caddy-apps"
SSH_APPS_DIR="{{ containers_home }}/appdeploy-state/ssh-apps"
DOMAIN_SUFFIX="{{ appdeploy_domain_suffix }}"

# shellcheck disable=SC2206
args=(${SSH_ORIGINAL_COMMAND:-})
app="${args[0]:-}"
port="${args[1]:-}"
app_type="${args[2]:-http}"
app_host="${args[3]:-}"

if [[ -z "$app" || -z "$port" || -z "$app_host" ]]; then
  echo "usage: <app> <port> [http|ssh] <app_host_app_ip>" >&2
  exit 1
fi
if [[ ! "$app" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]]; then
  echo "invalid app name: $app" >&2
  exit 1
fi
if [[ ! "$port" =~ ^[0-9]+$ ]]; then
  echo "invalid port: $port" >&2
  exit 1
fi
if [[ "$app_type" != "http" && "$app_type" != "ssh" ]]; then
  echo "invalid app type: $app_type (want http or ssh)" >&2
  exit 1
fi
if [[ ! "$app_host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "invalid app_host: $app_host" >&2
  exit 1
fi

if [[ "$app_type" == "ssh" ]]; then
  hostname="$app.ssh.$DOMAIN_SUFFIX"

  # Only so Caddy obtains a cert for this name; the layer4 tls handler
  # reuses it. SSH traffic never reaches this vhost.
  cat > "$CADDY_APPS_DIR/$app.caddy" <<EOF
$hostname {
	import acme_tls
	respond "this is an ssh app; connect with ssh, not https" 400
}
EOF

  # Imported by caddy-l4's layer4 block: match SNI, unwrap TLS, forward
  # plain SSH to the app.
  cat > "$SSH_APPS_DIR/$app.caddyroute" <<EOF
@$app tls sni $hostname
route @$app {
	tls
	proxy $app_host:$port
}
EOF
else
  # acme_tls (Caddyfile snippet): cert from the internal ACME server.
  cat > "$CADDY_APPS_DIR/$app.caddy" <<EOF
$app.$DOMAIN_SUFFIX {
	import acme_tls
	reverse_proxy $app_host:$port
}
EOF
  # Drop the layer4 route if this app switched from ssh to http.
  rm -f "$SSH_APPS_DIR/$app.caddyroute"
fi

# Both Caddy variants pin ContainerName=caddy.
podman exec caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile

if [[ "$app_type" == "ssh" ]]; then
  echo "routed $app.ssh.$DOMAIN_SUFFIX (TLS-wrapped SSH) -> $app_host:$port"
else
  echo "routed $app.$DOMAIN_SUFFIX -> $app_host:$port"
fi
