[Unit]
Description=Dovecot IMAP + LMTP
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/dovecot/dovecot:2.3.21.1
# Network=host, not a quadlet network -- Postfix (roles/mail_server,
# native on this same host, not containerized) needs to reach Dovecot's
# LMTP port over loopback for final delivery, and Roundcube's container
# needs to reach both Dovecot's IMAP and the host's Postfix submission
# port. Sharing the host netns lets all three talk over 127.0.0.1
# without a shared podman network or published ports in between -- same
# reasoning as caddy.container's own Network=host.
Network=host
Volume=/srv/containers/container-files/dovecot/data/conf.d:/etc/dovecot/conf.d:ro,z
# TLS cert/key and the virtual-mailbox passwd-file are generated by
# roles/mail_server (TLS: community.crypto, signed by the same offline
# intermediate CA container-sandbox's Caddy already uses -- see
# roles/common/tasks/trust_root_ca.yml for why every host already trusts
# it). Deliberately outside /srv/containers/container-files -- same
# reasoning as gitea.container's /srv/gitea/{data,config}: this repo
# gets rsync --delete'd/re-cloned on every containerapps run
# (containerapps_source=local in testrun.sh), which would wipe
# ansible-generated secrets living inside that tree.
Volume=/srv/dovecot/tls:/etc/dovecot/ssl:ro,z
Volume=/srv/dovecot/users:/etc/dovecot/users:ro,z
Volume=/srv/dovecot/vmail:/srv/mail:z

[Service]
Restart=always

[Install]
WantedBy=default.target
