[Unit]
Description=DNS (bind)
After=network-online.target
Wants=network-online.target

[Container]
Image=dns.build
PublishPort=15353:15353/udp
PublishPort=15353:15353/tcp
Sysctl=net.ipv4.ip_unprivileged_port_start=53
Volume=/srv/containers/container-files/dns/data/zones:/etc/bind/zones:z
Volume=/srv/containers/container-files/dns/data/named.conf:/etc/bind/named.conf:ro,z
Volume=/srv/containers/container-files/dns/data/keys:/etc/bind/keys:ro,z

[Service]
Restart=always

[Install]
WantedBy=default.target
