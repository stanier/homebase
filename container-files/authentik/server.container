[Unit]
Description=Authentik server
After=network-online.target postgresql.service redis.service
Wants=network-online.target postgresql.service redis.service

[Container]
Image=ghcr.io/goauthentik/server@sha256:21000cebe8e51eca0620034096586d675cedec8925ac750f7f8966d86eeb0da0
Exec=server
Network=authentik.network
PublishPort=9000:9000
Environment=AUTHENTIK_REDIS__HOST=redis
Environment=AUTHENTIK_POSTGRESQL__HOST=postgresql
Environment=AUTHENTIK_POSTGRESQL__USER=authentik
Environment=AUTHENTIK_POSTGRESQL__NAME=authentik
EnvironmentFile=/srv/containers/container-files/authentik/.env
Volume=authentik_authentik_media:/media
Volume=authentik_authentik_templates:/templates
# Plan 3's FreeIPA LDAP Source -- authentik auto-discovers any YAML
# under /blueprints (see its own docs on the blueprint directory
# structure), applying it on startup and re-applying on change without
# needing the admin UI's own "Apply" click each time.
Volume=/srv/containers/container-files/authentik/data/blueprints/freeipa-ldap-source.yaml:/blueprints/local/freeipa-ldap-source.yaml:ro,z
PodmanArgs=--memory=2g
PidsLimit=1024

[Service]
Restart=always

[Install]
WantedBy=default.target
