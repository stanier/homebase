[Unit]
Description=Wazuh indexer
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/wazuh/wazuh-indexer:4.14.7
Network=wazuh.network
NetworkAlias=wazuh-indexer
Environment=OPENSEARCH_JAVA_OPTS="-Xms1g -Xmx1g"
Volume=wazuh_wazuh_indexer_data:/var/lib/wazuh-indexer
Volume=/srv/containers/container-files/wazuh/data/wazuh_indexer/wazuh.indexer.yml:/usr/share/wazuh-indexer/config/opensearch.yml:ro,z
# certs/ and internal_users.yml are containerapps_secret_files, not
# tracked here -- see ansible-playbooks/docs/VAULT.md's Wazuh section.
# Destination filenames confirmed against the actual image (`podman run
# --rm --entrypoint ls wazuh/wazuh-indexer:4.14.7 config/certs`), not
# guessed from the upstream compose file -- it expects exactly these
# names, not the `wazuh.indexer*` naming the manager/dashboard mounts
# below use for their own certs.
Volume=/srv/containers/container-files/wazuh/data/wazuh_indexer/certs/root-ca.pem:/usr/share/wazuh-indexer/config/certs/root-ca.pem:ro,z
Volume=/srv/containers/container-files/wazuh/data/wazuh_indexer/certs/indexer.pem:/usr/share/wazuh-indexer/config/certs/indexer.pem:ro,z
Volume=/srv/containers/container-files/wazuh/data/wazuh_indexer/certs/indexer-key.pem:/usr/share/wazuh-indexer/config/certs/indexer-key.pem:ro,z
Volume=/srv/containers/container-files/wazuh/data/wazuh_indexer/certs/admin.pem:/usr/share/wazuh-indexer/config/certs/admin.pem:ro,z
Volume=/srv/containers/container-files/wazuh/data/wazuh_indexer/certs/admin-key.pem:/usr/share/wazuh-indexer/config/certs/admin-key.pem:ro,z
Volume=/srv/containers/container-files/wazuh/data/wazuh_indexer/internal_users.yml:/usr/share/wazuh-indexer/config/opensearch-security/internal_users.yml:ro,z
PodmanArgs=--memory=2g
HealthCmd=curl -k -s -o /dev/null -w '%{http_code}' https://127.0.0.1:9200
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=90s
HealthRetries=5

[Service]
Restart=always

[Install]
WantedBy=default.target
