[Unit]
Description=Stoa nginx (single ingress for agentd + webd)
After=network-online.target stoa-agentd.service stoa-webd.service
Wants=network-online.target
Requires=stoa-agentd.service

[Container]
Image=docker.io/library/nginx:1.30.0-alpine
Network=stoa-external.network
PublishPort=8090:8080
Volume=/srv/containers/container-files/stoa/data/config/nginx.conf:/etc/nginx/conf.d/default.conf:ro,z

[Service]
Restart=always

[Install]
WantedBy=default.target
