[Unit]
Description=Build stoa authd image
# See stoa-apikeyd.build's comment -- part of the same serialized chain.
After=stoa-apikeyd-build.service

[Build]
ImageTag=localhost/stoa-authd
File=Containerfile
Target=authd
# See stoa-apikeyd.build's comment.
SetWorkingDirectory=https://github.com/stanier/stoa.git#main

# See stoa-apikeyd.build's comment.
[Service]
TimeoutStartSec=3600
