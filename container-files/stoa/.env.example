# Reference only for the testzone/dangerzone environments -- their `stoa`
# host generates the real .env directly via ansible's containerapps_env
# (see host_vars/stoa.yml and this service's own README.md's "Before
# deploying"), so nothing here needs to be hand-copied there.
#
# Deploying stoa some other way (a different inventory, or by hand)? Copy
# this to .env in this directory (gitignored, never commit real values)
# and fill it in -- if it's still going through ansible, wire it via
# ansible-vault the same way as every other container-files secret, see
# ansible-playbooks/docs/VAULT.md's "container-files secrets".
# This file is read via EnvironmentFile= by authd, apikeyd, local-idp,
# agentd, webd, garage, and the three stoa-migrate-* one-shot units.
# Postgres passwords are intentionally NOT here -- see postgres-*.env.example.

# =============================================================================
# LLM provider -- left unset on purpose (undecided at scaffold time)
# =============================================================================
# LLM_PROVIDER=anthropic
# GATEWAY_API_URL=https://api.anthropic.com
# The actual API key is a Podman secret, not an env var -- see
# stoa-agentd.container's Secret=gateway_api_key line and:
#   podman secret create gateway_api_key -

# TITLING_ENABLED=true
# TITLING_PROVIDER=gateway
# TITLING_MODEL=claude-haiku-4-5

# =============================================================================
# Auth stack -- generate every *_TOKEN / *_SECRET below with: openssl rand -hex 32
# =============================================================================
AGENTD_DATABASE_URL=postgres://agentd:change-me@postgres-agentd:5432/agentd?sslmode=disable
AGENTD_MIGRATE_DATABASE_URL=postgres://agentd:change-me@postgres-agentd:5432/agentd?sslmode=disable

AUTHD_DATABASE_URL=postgres://authd:change-me@postgres-authd:5432/authd?sslmode=disable
AUTHD_MIGRATE_DATABASE_URL=postgres://authd:change-me@postgres-authd:5432/authd?sslmode=disable
AUTHD_EXTERNAL_URL=https://stoa-authd.example.internal
AUTHD_ADMIN_TOKEN=change-me
AUTHD_ALLOWED_REDIRECT_ORIGINS=https://stoa.example.internal,https://stoa-apikeyd.example.internal
# Same value as APIKEYD_ADMIN_TOKEN below -- authd calls apikeyd as an admin.
AUTHD_APIKEYD_ADMIN_TOKEN=change-me

LOCAL_IDP_DATABASE_URL=postgres://localidp:change-me@postgres-localidp:5432/localidp?sslmode=disable
LOCAL_IDP_MIGRATE_DATABASE_URL=postgres://localidp:change-me@postgres-localidp:5432/localidp?sslmode=disable
LOCAL_IDP_ISSUER=http://local-idp:9999
LOCAL_IDP_EXTERNAL_URL=https://stoa-local-idp.example.internal
LOCAL_IDP_REDIRECT_URIS=https://stoa-authd.example.internal/oauth/callback

# Shared secret between local-idp and authd for the "local" OIDC provider.
AUTHD_OAUTH_LOCAL_CLIENT_SECRET=change-me

APIKEYD_DATABASE_URL=postgres://apikeyd:change-me@postgres-apikeyd:5432/apikeyd?sslmode=disable
APIKEYD_EXTERNAL_URL=https://stoa-apikeyd.example.internal
APIKEYD_ADMIN_TOKEN=change-me

# =============================================================================
# Garage (S3-compatible storage for webd/agentd attachments)
# =============================================================================
# GARAGE_RPC_SECRET:        openssl rand -hex 32
# GARAGE_ACCESS_KEY_ID:     openssl rand -hex 16
# GARAGE_SECRET_ACCESS_KEY: openssl rand -hex 32
# Run garage's bucket/key setup once after first boot (see stoa's own
# scripts/garage-init.sh for the exact commands) -- this stack does not
# automate that step.
GARAGE_RPC_SECRET=change-me
GARAGE_ADMIN_TOKEN=change-me
GARAGE_BUCKET=uploads
GARAGE_S3_BUCKET=uploads
GARAGE_S3_ACCESS_KEY_ID=change-me
GARAGE_S3_SECRET_ACCESS_KEY=change-me

# =============================================================================
# webd
# =============================================================================
WEBD_EXTERNAL_URL=https://stoa.example.internal
WEBD_S3_BUCKET=uploads
WEBD_S3_ACCESS_KEY_ID=change-me
WEBD_S3_SECRET_ACCESS_KEY=change-me

# Shared HMAC secret between webd and mcp-attachments.
ATTACHMENT_SECRET=change-me

# =============================================================================
# MCP server credentials (optional -- leave blank to disable that server)
# =============================================================================
NETBOX_BASE_URL=
NETBOX_TOKEN=
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARDS=
PROMETHEUS_BASE_URL=
GRAPHQL_ENDPOINT=
