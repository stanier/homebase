[Unit]
Description=Build stoa local-idp image
# See stoa-apikeyd.build's comment -- part of the same serialized chain.
After=stoa-authd-build.service

[Build]
ImageTag=localhost/stoa-local-idp
File=Containerfile
Target=local-idp
SetWorkingDirectory=/srv/containers/container-files/stoa

# See stoa-apikeyd.build's comment.
[Service]
TimeoutStartSec=3600
