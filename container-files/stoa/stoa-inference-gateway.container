[Unit]
Description=Stoa inference-gateway (LLM API proxy for downstream apps, authenticated via apikeyd)
After=network-online.target stoa-apikeyd.service
Wants=network-online.target
Requires=stoa-apikeyd.service

[Container]
Image=stoa-inference-gateway.build
Network=stoa-external.network
NetworkAlias=inference-gateway
PublishPort=8080:8080
# One Secret= per upstream enabled in inference-gateway.yaml, mounted where
# that upstream's api_key_file points. Podman refuses to start the
# container if any listed secret is missing, so don't list secrets for
# disabled upstreams. inference-gateway doesn't read *_FILE env vars, only
# api_key_file. The anthropic upstream reuses agentd's gateway_api_key.
# The secrets themselves come from containerapps_podman_secrets.
Secret=gateway_api_key,type=mount,target=/run/secrets/anthropic_api_key
Secret=openrouter_api_key,type=mount,target=/run/secrets/openrouter_api_key
Volume=/srv/containers/container-files/stoa/data/config/inference-gateway.yaml:/etc/inference-gateway/config.yaml:ro,z
Exec=-config /etc/inference-gateway/config.yaml
HealthCmd=wget -qO- http://localhost:8080/healthz || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=6

[Service]
Restart=always

[Install]
WantedBy=default.target
