{
  "uid": "homebase-security",
  "title": "Security",
  "description": "SSH logins and failures, sudo use, Keycloak logins and auth logs from across the fleet. A quick look, not a replacement for Wazuh.",
  "tags": [
    "homebase",
    "loki",
    "security",
    "keycloak"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "ds_logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "Loki"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "ds_metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "VictoriaMetrics",
          "value": "VictoriaMetrics"
        },
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "hostname",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${ds_logs}"
        },
        "query": {
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 1,
          "label": "hostname",
          "stream": "{job=\"syslog\"}"
        },
        "definition": "label_values({job=\"syslog\"}, hostname)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "search",
        "label": "Auth log search (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Homebase",
      "type": "dashboards",
      "tags": [
        "homebase"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Summary (selected time range)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SSH auth failures",
      "datasource": {
        "type": "loki",
        "uid": "${ds_logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_logs}"
          },
          "expr": "sum(count_over_time({job=\"syslog\", hostname=~\"$hostname\", program=~\"sshd|sshd-session\"} |~ \"Failed (password|publickey|keyboard-interactive)|Invalid user\" [$__range]))",
          "refId": "A",
          "legendFormat": "__auto",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "description": "Failed password/publickey attempts plus invalid-user lines. One attempt at a nonexistent user can log both."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sources with failures",
      "datasource": {
        "type": "loki",
        "uid": "${ds_logs}"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_logs}"
          },
          "expr": "count(sum by (src) (count_over_time({job=\"syslog\", hostname=~\"$hostname\", program=~\"sshd|sshd-session\"} |~ \"Failed (password|publickey|keyboard-interactive)|Invalid user\" | regexp `from (?P<src>[0-9a-fA-F.:]+) port` [$__range])))",
          "refId": "A",
          "legendFormat": "__auto",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "orange"
              }
            ]
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
