        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Logins",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "hostname": 0,
              "user": 1,
              "src": 2,
              "method": 3,
              "Value": 4,
              "Value #A": 5
            },
            "renameByName": {
              "hostname": "Host",
              "user": "User",
              "src": "From",
              "method": "Method",
              "Value": "Logins",
              "Value #A": "Logins"
            }
          }
        }
      ]
