          "datasource": {
            "type": "loki",
            "uid": "${ds_logs}"
          },
          "expr": "sum by (hostname, user, method, src) (count_over_time({job=\"syslog\", hostname=~\"$hostname\", program=~\"sshd|sshd-session\"} |= \"Accepted \" | regexp `Accepted (?P<method>\\S+) for (?P<user>\\S+) from (?P<src>\\S+)` [$__range]))",
          "refId": "A",
          "legendFormat": "__auto",
          "queryType": "instant"
        }
