            "uid": "${ds_metrics}"
          },
          "expr": "label_replace(sum by (error) (increase(keycloak_user_events_total{job=\"keycloak\",event=\"login\"}[$__rate_interval])), \"error\", \"success\", \"error\", \"\")",
          "refId": "A",
          "legendFormat": "{{error}}",
          "range": true,
