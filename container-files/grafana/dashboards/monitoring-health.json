          "expr": "sum(vm_cache_entries{job=\"victoriametrics\",type=\"storage/hour_metric_ids\"})",
          "refId": "A",
          "legendFormat": "series",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
