        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "vmagent remote-write backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "sum(vmagent_remotewrite_pending_data_bytes{job=\"vmagent\"})",
          "refId": "A",
          "legendFormat": "pending",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "line",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Data vmagent has scraped but not yet delivered to VictoriaMetrics. Should hover near zero; a climb means VictoriaMetrics is down or slow."
    },
    {
      "id": 14,
      "type": "row",
      "title": "Loki",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Log lines by host",
      "datasource": {
        "type": "loki",
        "uid": "${ds_logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${ds_logs}"
          },
          "expr": "sum by (hostname) (count_over_time({job=\"syslog\"} [$__auto]))",
          "refId": "A",
          "legendFormat": "{{hostname}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
