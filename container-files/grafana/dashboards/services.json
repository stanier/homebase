        "sortBy": [
          {
            "displayName": "Status",
            "desc": false
          }
        ]
      },
      "description": "TCP: something accepted a connection on the port. DNS: the server answered an SOA query for the environment's zone.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "job": 0,
              "instance": 1,
              "target": 2,
              "Value #A": 3,
              "Value #B": 4
            },
            "renameByName": {
              "job": "Check",
              "instance": "What",
              "target": "Address",
              "Value #A": "Status",
              "Value #B": "Response time"
