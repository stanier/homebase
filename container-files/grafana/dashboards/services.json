        }
      },
      "description": "Whole probe: DNS, connect, TLS, every redirect hop, and the final response."
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Probe history",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_metrics}"
          },
          "expr": "max by (instance) (probe_success)",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green"
                },
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
