    {
      "id": 12,
      "type": "row",
      "title": "Caddy (container-sandbox)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Requests/s by vhost",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_metrics}"
      },
      "gridPos": {
