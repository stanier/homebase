FROM docker.io/library/caddy:2-builder AS build
# caddy-l4 pulls in a much heavier module tree than plain Caddy (AWS/GCP
# KMS SDKs, quic-go, gonum, ...), and caddy:2-builder's own default of
# XCADDY_SKIP_CLEANUP=1 deliberately leaves xcaddy's /tmp/buildenv_*
# workspace (a full copy of the module cache + build output) behind
# after the build. On a small root disk that combination is enough to
# fill it mid-build ("no space left on device"). Clean the workspace
# and Go's caches in the same layer so the peak footprint during commit
# stays bounded.
ENV XCADDY_SKIP_CLEANUP=0
RUN xcaddy build \
    --with github.com/mholt/caddy-l4 \
    --with github.com/mholt/caddy-l4/modules/l4tls \
    --with github.com/mholt/caddy-l4/modules/l4proxy \
    && go clean -cache -modcache \
    && rm -rf /tmp/buildenv_*

FROM docker.io/library/caddy:2-alpine
COPY --from=build /usr/bin/caddy /usr/bin/caddy

COPY data/Caddyfile /etc/caddy/Caddyfile
