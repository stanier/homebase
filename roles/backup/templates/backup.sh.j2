#!/bin/bash
# Managed by ansible-playbooks (roles/backup) -- edits here are
# overwritten on the next run.
#
# Deliberately reads {{ containers_home }}/.config/containers/systemd
# instead of taking its own list of services: that directory is exactly
# what containerapps has actually deployed and started on this host (see
# roles/containerapps/tasks/quadlet_service.yml), so this backs up
# whatever's really running rather than a second, hand-maintained list
# that can drift out of sync with it.
set -euo pipefail

export XDG_RUNTIME_DIR="/run/user/$(id -u)"

QUADLET_DIR="{{ containers_home }}/.config/containers/systemd"
EXCLUDE=({{ backup_exclude_services | map('quote') | join(' ') }})

is_excluded() {
  local svc="$1" x
  for x in "${EXCLUDE[@]:-}"; do
    [[ "$svc" == "$x" ]] && return 0
  done
  return 1
}

shopt -s nullglob
for unit in "$QUADLET_DIR"/*.container; do
  service="$(basename "$unit" .container)"
  is_excluded "$service" && continue

  # Quadlet's Volume= is "source:dest[:options]" (podman-run's -v syntax).
  # source is either an absolute bind-mount path or a named volume --
  # anything not starting with "/" is looked up via `podman volume
  # inspect` to find where it actually lives on disk. See the
  # authentik/grafana .container files, which use both forms.
  while IFS= read -r line; do
    src="${line#Volume=}"
    src="${src%%:*}"
    [[ -z "$src" ]] && continue

    if [[ "$src" == /* ]]; then
      path="$src"
    else
      path="$(podman volume inspect --format '{{ '{{' }}.Mountpoint{{ '}}' }}' "$src" 2>/dev/null)" || {
        echo "warning: could not resolve volume '$src' for $service, skipping" >&2
        continue
      }
    fi

    echo "backing up $service: $path"
    restic backup "$path" --tag "host={{ inventory_hostname }}" --tag "service=$service" --tag "volume=$src"
  done < <(grep -h '^Volume=' "$unit" || true)
done

restic forget --prune \
  --keep-daily {{ backup_retention_daily }} \
  --keep-weekly {{ backup_retention_weekly }} \
  --keep-monthly {{ backup_retention_monthly }} \
  --tag "host={{ inventory_hostname }}"
