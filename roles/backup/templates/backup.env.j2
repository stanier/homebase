# Managed by ansible-playbooks (roles/backup). Loaded via backup.service's
# EnvironmentFile= so restic's repo secret and backend credentials never
# appear in backup.sh itself or in `systemctl status` output.
RESTIC_REPOSITORY={{ backup_repository }}
RESTIC_PASSWORD={{ backup_password }}
AWS_ACCESS_KEY_ID={{ backup_aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ backup_aws_secret_access_key }}
