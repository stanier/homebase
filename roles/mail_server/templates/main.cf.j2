# Managed by ansible-playbooks (roles/mail_server). Real receiving MTA
# for {{ mail_server_domain }} -- accepts relayed mail from every
# roles/postfix satellite (mynetworks below) and final-delivers to
# Dovecot (container, this same host) over LMTP.
myhostname = {{ ansible_fqdn | default(inventory_hostname) }}.{{ mail_server_domain }}
mydomain = {{ mail_server_domain }}
myorigin = $mydomain
mydestination =

inet_interfaces = all
inet_protocols = ipv4
mynetworks = {{ mail_server_relay_networks | join(' ') }}

virtual_mailbox_domains = {{ mail_server_domain }}
virtual_mailbox_maps = texthash:/etc/postfix/virtual_mailboxes
virtual_transport = lmtp:127.0.0.1:24

# Empty, not Postfix's own default (hash:/etc/aliases) -- mydestination
# above is empty too, so nothing here is ever treated as a local
# delivery and alias_maps is never actually consulted, but Postfix still
# tries to open it at smtpd startup regardless. This build has no
# Berkeley DB support ("unsupported dictionary type: hash"), so the
# default warns on every start for a lookup that was always a no-op here.
alias_maps =

# /etc/postfix/tls/*, not /srv/dovecot/tls/* directly -- dovecot.container's
# bind mount (see its own Volume=...:z) relabels that copy to
# container_file_t so the Dovecot container can read it, which then
# confines it away from native processes: Postfix (this file, running on
# the host, not in a container) gets a flat "Permission denied" trying
# to fopen() it. This is a separate copy with its own default SELinux
# context instead (see the copy task in tasks/main.yml).
smtpd_tls_cert_file = /etc/postfix/tls/tls.crt
smtpd_tls_key_file = /etc/postfix/tls/tls.key
smtpd_tls_security_level = may
smtp_tls_security_level = may

compatibility_level = 3
